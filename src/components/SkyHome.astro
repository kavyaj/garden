---
// Home's tall sky: 900px, canopy in both top corners, layered clouds, birds. Ends in a cloud bank that turns into paper.
import Scene from './Scene.astro';
import SiteHeader from './SiteHeader.astro';
import sky from '../scene/generated/sky-home.json';
---

<div class="sky sky--home">
  <Scene scene={sky} />
  <div class="wrap wrap--home sky-inner">
    <SiteHeader />
    <slot />
  </div>
</div>

<style>
  .sky--home {
    position: relative;
    height: 900px;
    background: var(--sky-low);
    overflow: hidden;
  }
  .sky-inner {
    position: relative;
    padding-top: var(--space-5);
  }
  .sky--home :global(.scene) {
    top: 0;
  }
</style>
