---
// "Mentioned in" at the foot of a note, with the small tendril glyph. Renders nothing when empty.
import type { CollectionEntry } from 'astro:content';

interface Props {
  notes: CollectionEntry<'notes'>[];
}
const { notes } = Astro.props;
---

{
  notes.length > 0 && (
    <section class="backlinks" aria-labelledby="backlinks-h">
      <h2 id="backlinks-h" class="label">
        <svg viewBox="0 0 30 16" aria-hidden="true">
          <path d="M1 12 C8 12 12 4 19 5 C25 6 24 13 19 12 C16 11 17 7 20 8" />
        </svg>
        Mentioned in
      </h2>
      <ul>
        {notes.map((n) => (
          <li>
            <a class="kw-ul" href={`/notes/${n.id}`}>
              {n.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .backlinks {
    max-width: var(--measure-text);
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--hair);
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }
  svg {
    width: 26px;
    height: 14px;
    overflow: visible;
  }
  path {
    fill: none;
    stroke: var(--green);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    font-size: 16px;
  }
  li a {
    display: inline-block;
    padding: 10px 0;
    background-position: 0 calc(100% - 10px);
  }
</style>
