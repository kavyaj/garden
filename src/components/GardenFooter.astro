---
// Every page ends in the garden. The arch is a link: to the map, or on the map, back home.
// Hovering or focusing it swings both gate leaves open. Below it, the footer on garden-deep.
import Scene from './Scene.astro';
import garden from '../scene/generated/garden.json';
import { nav, site } from '../site';

interface Props {
  atMap?: boolean;
}
const { atMap = false } = Astro.props;
const arch = atMap
  ? { href: '/', sign: 'back to the start', label: 'Through the gate: back to the start' }
  : { href: '/map', sign: 'the map, this way', label: 'Through the gate: a map of the whole garden' };
const year = site.planted.slice(0, 4);
---

<div class="garden">
  <a class="g-archlink" href={arch.href} aria-label={arch.label}>
    <span class="g-sign" aria-hidden="true"><span class="g-sign-board">{arch.sign}</span></span>
  </a>
  <Scene scene={garden} />
</div>

<footer class="kw-garden-foot">
  <div class="wrap wrap--home foot">
    <div>
      <p class="signoff">thanks for wandering in</p>
      <p class="kw-heading line">Come back. It'll have grown.</p>
    </div>
    <div class="foot-right">
      <nav aria-label="Garden">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="small">
        <span>Planted {year} in {site.place}</span>
        {site.socials.map((s) => <a href={s.href} rel="me">{s.label}</a>)}
      </div>
    </div>
  </div>
</footer>

<style>
  /* The scene is 1440×740, anchored bottom-centre and scaled up past 1440px wide (xMidYMax slice).
     --s is that scale as a length, so things placed in scene units line up at any width. */
  .garden {
    position: relative;
    height: 740px;
    margin-top: clamp(72px, 10vw, 120px);
    overflow: hidden;
    container-type: inline-size;
  }
  .garden :global(.scene) {
    bottom: 0;
  }
  /* Covers the arch (scene x 530–910, y 160–600) and the sign's stake on the path below it. */
  .g-archlink {
    --s: max(1px, 100cqw / 1440);
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: calc(36 * var(--s));
    width: min(100%, calc(380 * var(--s)));
    height: calc(544 * var(--s));
    transform: translateX(-50%);
    text-decoration: none;
    color: var(--ink);
  }
  /* A sign on a stake, planted at the right edge of the path (scene x 820). It stays put when the gate opens. */
  .g-sign {
    position: absolute;
    left: calc(50% + 100 * var(--s));
    bottom: 0;
    display: block;
    padding-bottom: 34px;
    transform: translateX(-50%) rotate(-3deg);
    transform-origin: 50% 100%;
  }
  .g-sign-board {
    position: relative;
    z-index: 1;
    display: block;
    background: var(--paper-lift);
    border: 1.5px solid var(--ink);
    padding: 4px 12px 5px;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 16px;
    white-space: nowrap;
    box-shadow: 3px 4px 0 rgba(19, 19, 19, 0.12);
  }
  .g-sign::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 4px;
    height: 40px;
    margin-left: -2px;
    background: var(--ink);
  }
  .g-archlink:hover .g-sign-board {
    text-decoration: underline;
    text-decoration-color: var(--spot);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
    padding-top: clamp(32px, 5vw, 48px);
    padding-bottom: 28px;
  }
  .signoff {
    margin-bottom: 6px;
    font-family: var(--font-hand);
    font-size: 17px;
    color: var(--spot-soft);
  }
  .line {
    font-size: clamp(26px, 3.6vw, 38px);
    color: var(--paper);
  }
  .foot-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .foot nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    font-size: 15px;
    font-weight: 500;
  }
  .foot a {
    color: var(--paper);
  }
  .foot nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .foot nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--spot-soft);
    text-underline-offset: 5px;
  }
  .small {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 22px;
    font-size: 13px;
    color: rgba(240, 240, 240, 0.8);
  }
  .small a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .kw-garden-foot :focus-visible {
    outline: 2px solid var(--spot-soft);
    outline-offset: 3px;
  }
</style>
