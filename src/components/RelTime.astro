---
// A date that reads "3 days ago" in the browser and the plain date without JS. See the script in Base.astro.
import { iso, plainDate } from '../lib/garden';

interface Props {
  date: Date;
  /** Text before the relative part, e.g. "Tended ". */
  prefix?: string;
  /** Past a month: "in August" (sentence) or "August 2026" (a list column). */
  older?: 'sentence' | 'month';
}
const { date, prefix = '', older = 'sentence' } = Astro.props;
---

<time datetime={iso(date)} data-rel={prefix} data-older={older}>{prefix}{plainDate(date)}</time>
