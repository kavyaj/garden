---
// The map's sky: Home's sky at 620px.
import Scene from './Scene.astro';
import SiteHeader from './SiteHeader.astro';
import sky from '../scene/generated/sky-map.json';
---

<div class="sky sky--map">
  <Scene scene={sky} />
  <div class="wrap wrap--map sky-inner">
    <SiteHeader />
    <slot />
  </div>
</div>

<style>
  .sky--map {
    position: relative;
    height: 620px;
    background: var(--sky-low);
    overflow: hidden;
  }
  .sky-inner {
    position: relative;
    padding-top: var(--space-5);
  }
  .sky--map :global(.scene) {
    top: 0;
  }
</style>
