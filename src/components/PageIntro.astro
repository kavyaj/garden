---
// The top of an inner page: a handwritten kicker, the title, and a line or two of DM Sans.
interface Props {
  kicker?: string;
  title: string;
}
const { kicker, title } = Astro.props;
---

<section class="intro">
  {kicker && <p class="kicker">{kicker}</p>}
  <h1 class="kw-display">{title}</h1>
  <div class="lede"><slot /></div>
</section>

<style>
  .intro {
    padding: clamp(32px, 6vw, 72px) 0 clamp(24px, 4vw, 40px);
  }
  .kicker {
    margin-bottom: 6px;
    font-family: var(--font-hand);
    font-size: 18px;
    color: var(--moss);
    transform: rotate(var(--tilt-m));
    transform-origin: left;
  }
  h1 {
    margin-bottom: 18px;
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .lede {
    max-width: var(--measure-text);
  }
  .lede :global(p + p) {
    margin-top: 0.8em;
  }
</style>
