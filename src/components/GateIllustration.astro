<style>
  .gate-wrap {
    flex: 1 1 260px;
    max-width: 330px;
  }
  .gatelink {
    display: block;
    text-decoration: none;
  }
  .gatelink svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .caption {
    margin: 6px 0 0 18px;
    font-family: var(--font-hand);
    font-size: 14.5px;
    color: var(--muted);
  }
  .grow {
    opacity: 0;
    transform: translateY(8px);
    animation: rise 0.8s cubic-bezier(0.3, 0.6, 0.3, 1) forwards;
  }
  .g1 {
    animation-delay: 0.1s;
  }
  .g2 {
    animation-delay: 0.25s;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .bar {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s cubic-bezier(0.35, 0.1, 0.25, 1) 0.7s forwards;
  }
  .stem {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.4s cubic-bezier(0.35, 0.1, 0.25, 1) 1s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .leaf,
  .bloom {
    opacity: 0;
    animation: pop 0.5s ease 2.1s forwards;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .gate {
    transition: transform 0.7s cubic-bezier(0.4, 0.1, 0.2, 1);
  }
  .gatelink:hover .gl,
  .gatelink:focus-visible .gl,
  .gatelink:hover .gr,
  .gatelink:focus-visible .gr {
    transform: scaleX(0.2);
  }
  .flower {
    transition: transform 0.6s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .gatelink:hover .flower,
  .gatelink:focus-visible .flower {
    transform: rotate(-3deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .grow,
    .leaf,
    .bloom {
      opacity: 1;
      transform: none;
    }
    .bar,
    .stem {
      stroke-dashoffset: 0;
    }
  }
</style>
