---
// Wraps a rendered note or chapter: the highlighter behind one phrase, quoted tweets as quiet cards,
// and glossary words with a tooltip. See src/lib/prose.ts.
import { highlight, tweetCards, glossary } from '../lib/prose';

interface Props {
  phrase?: string;
  glossary?: Record<string, string>;
}
const { phrase, glossary: words } = Astro.props;
const html = glossary(tweetCards(highlight(await Astro.slots.render('default'), phrase)), words);
---

<Fragment set:html={html} />
