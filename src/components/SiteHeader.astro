---
// The horizontal lockup (deep-green mark, 32px, and the name in Fraunces), then five plain-word links.
// The map isn't here. The logo never animates.
import { nav, site } from '../site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => path === href || path.startsWith(href + '/');
// The book about Thatha lives under Things I've made, so that link stays marked while you read it.
const within = (href: string) => href === '/made' && (path === '/thatha' || path.startsWith('/thatha/'));
---

<header class="wrap site-header">
  <a class="home" href="/">
    <img src="/brand/kj-mark-deep-green.svg" alt="" width="32" height="32" />
    <span>{site.name}</span>
  </a>
  <nav class="kw-nav" aria-label="Main">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={current(item.href) ? 'page' : within(item.href) ? 'true' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 22px;
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .home img {
    display: block;
    width: 32px;
    height: 32px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-size: 15px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
  }
</style>
