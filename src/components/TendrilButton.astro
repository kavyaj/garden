---
// The design system's Button: a label with an underline that ends in a coil. No box, no arrow.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}
const { href, variant = 'primary' } = Astro.props;
---

<a class:list={['kw-btn', `kw-btn--${variant}`]} href={href}
  ><span class="kw-btn-label"><slot /></span><svg class="kw-btn-coil" viewBox="0 0 22 20" aria-hidden="true"
    ><path pathLength="1" d="M0 10 C7 10 14 10 17 6 C20 2 15 -1 12 2 C9 5 12 9 15 7"></path><path
      class="kw-btn-leaf"
      d="M17 7 C18 2 22 0 25 1 C24 5 21 8 17 7Z"></path></svg
  ></a
>

<style>
  /* Floors: every link at least 44px tall. The design system's 10px padding gives about 40. */
  .kw-btn {
    padding: 12px 0;
  }
  /* The secondary coil is undrawn at rest, but its round cap still leaves a dot. Hide it until hover. */
  .kw-btn--secondary .kw-btn-coil {
    opacity: 0;
    transition: opacity 0.15s;
  }
  .kw-btn--secondary:hover .kw-btn-coil,
  .kw-btn--secondary:focus-visible .kw-btn-coil {
    opacity: 1;
  }
</style>
