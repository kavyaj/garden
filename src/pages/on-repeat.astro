---
// Interim: the song list. The MP3 player replaces the turntable in the next step.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const songs = (await getCollection('songs')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="On repeat" description="The songs I keep going back to, and the memories stuck to each one.">
  <section class="page-top">
    <h1 class="h1">On repeat</h1>
    <ol>
      {songs.map((s) => <li>{s.data.title}, {s.data.artist}</li>)}
    </ol>
  </section>
</Base>
