---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sleeve } from '../sleeves';
import { count } from '../lib/garden';

const records = (await getCollection('records')).sort((a, b) => a.data.order - b.data.order);

// Every sleeve on the shelf is different.
const seen = new Map<string, string>();
for (const r of records) {
  const other = seen.get(r.data.sleeve);
  if (other) throw new Error(`records.yaml: "${r.data.title}" and "${other}" both use the "${r.data.sleeve}" sleeve.`);
  seen.set(r.data.sleeve, r.data.title);
}

const listenLabel = (url: string) => {
  const host = new URL(url).hostname;
  if (host.includes('spotify')) return 'Listen on Spotify';
  if (host.includes('youtube') || host.includes('youtu.be')) return 'Listen on YouTube';
  if (host.includes('apple')) return 'Listen on Apple Music';
  return 'Listen';
};
const data = records.map((r) => ({
  title: r.data.title,
  artist: r.data.artist,
  // The vinyl label: the title in caps, cut to fit.
  label: r.data.title.toUpperCase().slice(0, 14),
  note: r.data.note,
  url: r.data.listen_url,
  listen: listenLabel(r.data.listen_url),
  spotify: r.data.spotify ?? '',
}));
const n = records.length;
---

<Base title="On repeat" description="The records I keep going back to, and what each one is attached to.">
  <section class="page-top intro">
    <h1 class="h1">On repeat</h1>
    <p class="lede">
      {count(n, 'record')} I keep going back to, and what {n === 1 ? "it's" : 'each one is'} attached to. Pick a sleeve, then drop the needle.
    </p>
  </section>

  <section class="deck" data-turntable>
    <div class="player">
      <div class="plinth">
        <div class="platter">
          <div class="vinyl" data-vinyl>
            <div class="vinyl-label"><b data-label></b></div>
            <span class="shine"></span>
          </div>
          <div class="spindle"></div>
        </div>
        <div class="arm" data-arm aria-hidden="true">
          <svg viewBox="0 0 120 190">
            <circle cx="103" cy="18" r="15" fill="var(--green-soft)"></circle>
            <circle cx="103" cy="18" r="5" fill="var(--ink)"></circle>
            <path d="M103 30 L103 148 Q103 164 86 168" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round"></path>
            <rect x="68" y="160" width="24" height="13" rx="2" fill="var(--ink)" transform="rotate(-14 80 166)"></rect>
          </svg>
        </div>
      </div>
      <button type="button" class="needle" data-toggle disabled><span class="kw-lbl" data-toggle-label>Pick a record first</span></button>
      <div class="now" aria-live="polite">
        <p class="muted" data-empty>Nothing on yet.</p>
        <div data-info hidden>
          <p class="now-title" data-title></p>
          <p class="now-artist"><span data-artist></span><span class="playing" data-playing hidden> · playing</span></p>
          <p class="now-note" data-note></p>
          <div class="embed" data-embed hidden><div data-embed-slot></div></div>
          <a class="kw-tl" data-listen href="#"
            ><span class="kw-lbl" data-listen-label></span><svg viewBox="0 0 20 16" aria-hidden="true"
              ><path pathLength="1" d="M0 14 C6 14 12 13 14 9 C16 5 12 2 9.5 4.5 C7.5 6.5 10 10 12.5 8"></path></svg
            ></a
          >
        </div>
      </div>
    </div>

    <div class="shelf-col">
      <h2 class="label shelf-h">The shelf</h2>
      <ul class="shelf">
        {
          records.map((r, i) => (
            <li>
              <button type="button" class="sleeve" data-pick={i} aria-pressed="false" aria-label={`${r.data.title} by ${r.data.artist}`}>
                <svg viewBox="0 0 100 100" aria-hidden="true" set:html={sleeve(r.data.sleeve)} />
              </button>
              <span class="caption">
                <span class="cap-title">{r.data.title}</span>
                <span class="cap-artist">{r.data.artist}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <script type="application/json" data-records set:html={JSON.stringify(data)} />
  </section>
</Base>

<script>
  // The turntable. Pick a sleeve, then "Drop the needle": the crackle fades in (WebAudio noise through a 700Hz
  // highpass), and after a moment the song starts in Spotify's player, with the crackle sinking under it.
  // Nothing from Spotify loads until the first needle drop. The audio context only exists after the first click.
  type Rec = { title: string; artist: string; label: string; note: string; url: string; listen: string; spotify: string };
  type Controller = {
    loadUri(uri: string): void;
    play(): void;
    pause(): void;
    resume(): void;
    addListener(event: string, cb: (e: { data: { isPaused?: boolean; position?: number } }) => void): void;
  };
  type SpotifyAPI = { createController(el: Element, opts: Record<string, unknown>, cb: (c: Controller) => void): void };

  const SONG_DELAY = 1500; // ms of crackle before the song comes in
  const CRACKLE = 0.35; // crackle on its own
  const UNDER = 0.07; // crackle under the song

  const root = document.querySelector<HTMLElement>('[data-turntable]');
  if (root) {
    const records: Rec[] = JSON.parse(root.querySelector('[data-records]')!.textContent || '[]');
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as unknown as T;
    const sleeves = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const toggle = $<HTMLButtonElement>('[data-toggle]');
    let cur: number | null = null;
    let playing = false;

    let ctx: AudioContext | null = null;
    let gain: GainNode | null = null;
    function crackle(on: boolean | number) {
      try {
        if (!ctx) {
          ctx = new AudioContext();
          const len = ctx.sampleRate * 2;
          const buf = ctx.createBuffer(1, len, ctx.sampleRate);
          const d = buf.getChannelData(0);
          for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (Math.random() < 0.0009 ? 1 : 0.03);
          const src = ctx.createBufferSource();
          src.buffer = buf;
          src.loop = true;
          const hp = ctx.createBiquadFilter();
          hp.type = 'highpass';
          hp.frequency.value = 700;
          gain = ctx.createGain();
          gain.gain.value = 0;
          src.connect(hp).connect(gain).connect(ctx.destination);
          src.start();
        }
        if (ctx.state === 'suspended') ctx.resume();
        gain!.gain.setTargetAtTime(on === true ? CRACKLE : on === false ? 0 : on, ctx.currentTime, on === false ? 0.12 : 0.25);
      } catch {
        // No sound is fine. The record still spins.
      }
    }

    // Spotify's player, loaded on the first needle drop and reused after that.
    const trackUri = (url: string) => 'spotify:track:' + (url.match(/track\/([A-Za-z0-9]+)/)?.[1] ?? '');
    let api: Promise<SpotifyAPI> | null = null;
    let player: Promise<Controller> | null = null;
    let loadedUri = '';
    let songTimer = 0;
    let songStarted = false;

    function loadApi(): Promise<SpotifyAPI> {
      api ??= new Promise((resolve) => {
        (window as unknown as { onSpotifyIframeApiReady: (a: SpotifyAPI) => void }).onSpotifyIframeApiReady = resolve;
        const tag = document.createElement('script');
        tag.src = 'https://open.spotify.com/embed/iframe-api/v1';
        tag.async = true;
        document.head.appendChild(tag);
      });
      return api;
    }

    function getPlayer(uri: string): Promise<Controller> {
      player ??= loadApi().then(
        (a) =>
          new Promise<Controller>((resolve) => {
            a.createController($('[data-embed-slot]'), { uri, width: '100%', height: 80 }, (c) => {
              loadedUri = uri;
              // If the visitor pauses in Spotify's player, or the song ends, the needle lifts too.
              c.addListener('playback_update', (e) => {
                if (e.data.isPaused === false) songStarted = true;
                if (songStarted && e.data.isPaused && playing) {
                  songStarted = false;
                  play(false);
                }
              });
              resolve(c);
            });
          })
      );
      return player;
    }

    function startSong(r: Rec) {
      clearTimeout(songTimer);
      if (!r.spotify) return;
      const uri = trackUri(r.spotify);
      $('[data-embed]').hidden = false;
      const ready = getPlayer(uri);
      songTimer = window.setTimeout(async () => {
        const c = await ready;
        if (!playing || cur === null || records[cur] !== r) return;
        if (loadedUri !== uri) {
          c.loadUri(uri);
          loadedUri = uri;
        }
        c.play();
        crackle(UNDER);
      }, SONG_DELAY);
    }

    function stopSong() {
      clearTimeout(songTimer);
      songStarted = false;
      player?.then((c) => c.pause());
    }

    function play(on: boolean) {
      if (cur === null) return;
      playing = on;
      crackle(on);
      if (on) startSong(records[cur]);
      else stopSong();
      render();
    }

    function render() {
      const r = cur === null ? null : records[cur];
      sleeves.forEach((s, i) => s.setAttribute('aria-pressed', String(i === cur)));
      $('[data-vinyl]').classList.toggle('on', !!r);
      $('[data-vinyl]').classList.toggle('spin', playing);
      $('[data-arm]').classList.toggle('down', playing);
      toggle.disabled = !r;
      $('[data-toggle-label]').textContent = !r ? 'Pick a record first' : playing ? 'Lift the needle' : 'Drop the needle';
      $('[data-empty]').hidden = !!r;
      $('[data-info]').hidden = !r;
      if (r) {
        $('[data-label]').textContent = r.label;
        $('[data-title]').textContent = r.title;
        $('[data-artist]').textContent = r.artist;
        $('[data-playing]').hidden = !playing;
        const note = $('[data-note]');
        note.textContent = r.note;
        note.hidden = !r.note;
        if (!r.spotify) $('[data-embed]').hidden = true;
        $<HTMLAnchorElement>('[data-listen]').href = r.url;
        $('[data-listen-label]').textContent = r.listen;
      }
    }

    sleeves.forEach((s, i) =>
      s.addEventListener('click', () => {
        if (playing) stopSong();
        crackle(false);
        cur = i;
        playing = false;
        render();
      })
    );
    toggle.addEventListener('click', () => play(!playing));
  }
</script>

<style>
  .intro {
    max-width: 40rem;
  }
  .deck {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
    align-items: flex-start;
    margin-top: 56px;
  }
  .player {
    flex: 1 1 24rem;
    min-width: 0;
    max-width: 30rem;
  }
  .plinth {
    position: relative;
    aspect-ratio: 1 / 0.86;
    background: var(--paper-lift);
    border: 1px solid var(--hair);
    border-radius: var(--radius-1);
  }
  .platter {
    position: absolute;
    left: 7%;
    top: 50%;
    transform: translateY(-50%);
    width: 70%;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: #e6e1d6;
  }
  .vinyl {
    position: absolute;
    inset: 3%;
    border-radius: var(--radius-full);
    background: var(--ink) repeating-radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.06) 0 1px, rgba(255, 255, 255, 0) 1px 4px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .vinyl:global(.on) {
    opacity: 1;
  }
  .vinyl:global(.spin) {
    animation: rev 1.8s linear infinite;
  }
  @keyframes rev {
    to {
      transform: rotate(360deg);
    }
  }
  .vinyl-label {
    position: absolute;
    left: 33%;
    top: 33%;
    width: 34%;
    height: 34%;
    display: grid;
    place-items: center;
    padding: 4px;
    border-radius: var(--radius-full);
    background: var(--spot);
    text-align: center;
  }
  .vinyl-label b {
    font-size: 9px;
    line-height: 1.15;
    letter-spacing: 0.04em;
    font-weight: 600;
    color: var(--ink);
  }
  .shine {
    position: absolute;
    left: 62%;
    top: 16%;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.25);
  }
  .spindle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3.4%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: var(--radius-full);
    background: var(--paper);
  }
  .arm {
    position: absolute;
    right: 8%;
    top: 9%;
    width: 34%;
    height: 60%;
    pointer-events: none;
    transform-origin: 86% 10%;
    transition: transform 0.7s cubic-bezier(0.4, 0.1, 0.2, 1);
  }
  .arm:global(.down) {
    transform: rotate(24deg);
  }
  .arm svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .needle {
    display: inline-flex;
    align-items: flex-end;
    min-height: 44px;
    padding: 12px 0 10px;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .needle[disabled] {
    color: var(--muted);
    cursor: default;
  }
  .needle[disabled] .kw-lbl {
    background: none;
  }
  .now {
    min-height: 8rem;
    margin-top: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--hair);
  }
  .now-title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 36, 'SOFT' 40;
    font-weight: 500;
    font-size: 26px;
    line-height: 1.15;
  }
  .now-artist {
    margin: 2px 0 12px;
    font-size: 15px;
    color: var(--muted);
  }
  .playing {
    color: var(--green);
    font-weight: 600;
  }
  .now-note {
    margin-bottom: 14px;
    font-size: 17px;
    line-height: 1.6;
  }
  /* Spotify's player sits on the paper under the record's details. Loaded on the first needle drop. */
  .embed {
    margin: 0 0 14px;
  }
  .embed :global(iframe) {
    display: block;
    width: 100%;
    border: 0;
    border-radius: 12px;
  }
  .now :global(.kw-tl) {
    font-size: 15px;
  }

  .shelf-col {
    flex: 1 1 20rem;
    min-width: 0;
  }
  .shelf-h {
    margin-bottom: 14px;
  }
  .shelf {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px 22px;
  }
  @media (max-width: 380px) {
    .shelf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .sleeve {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    background: var(--paper-lift);
    border: 1px solid var(--hair);
    cursor: pointer;
    transition: transform 0.2s;
  }
  .sleeve:hover {
    transform: translateY(-2px);
  }
  .sleeve svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sleeve[aria-pressed='true']::after {
    content: '';
    position: absolute;
    inset: -5px;
    border: 2px solid var(--spot);
    pointer-events: none;
  }
  .caption {
    display: block;
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.3;
  }
  .cap-title {
    font-weight: 600;
  }
  .cap-artist {
    display: block;
    font-size: 13px;
    color: var(--muted);
  }
</style>
