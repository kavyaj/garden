---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import QuoteTile from '../components/QuoteTile.astro';

const quotes = (await getCollection('quotes')).sort((a, b) => b.data.added.getTime() - a.data.added.getTime());

// CLAUDE.md: the ink ticket, two on the page at most.
const ink = quotes.filter((q) => q.data.ink);
if (ink.length > 2) {
  throw new Error(`quotes.yaml: ${ink.length} quotes have ink: true (${ink.map((q) => q.id).join(', ')}). Two at most.`);
}

// Long quotes get two columns on the bento; short ones one.
const wide = (q: (typeof quotes)[number]) => q.data.original.length + q.data.translation.length > 150;
---

<Base title="Quotes" description="Lines I keep needing, in the language I first met them, each with a note on why." strip="quotes" devanagari>
  <PageIntro kicker="the shelf" title="Quotes">
    <p>
      Lines I keep needing, in the language I first met them. Each one has a note from me tucked under the tear-line. Tap
      a quote to unfold it.
    </p>
  </PageIntro>

  {
    quotes.length ? (
      <section class="bento" aria-label="Quotes">
        {quotes.map((q) => (
          <div class:list={['tile', { 'tile--wide': wide(q) }]}>
            <QuoteTile quote={q} />
          </div>
        ))}
      </section>
    ) : (
      <p class="empty">The shelf's empty for now.</p>
    )
  }
</Base>

<script>
  // One note open at a time.
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('.quote-tile[aria-controls]')];
  for (const tile of tiles) {
    tile.addEventListener('click', () => {
      const open = tile.getAttribute('aria-expanded') === 'true';
      for (const t of tiles) t.setAttribute('aria-expanded', 'false');
      tile.setAttribute('aria-expanded', String(!open));
    });
  }
</script>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    grid-auto-flow: dense;
    gap: 20px;
    align-items: start;
  }
  @media (min-width: 720px) {
    .tile--wide {
      grid-column: span 2;
    }
  }
  .empty {
    color: var(--moss);
  }
</style>
