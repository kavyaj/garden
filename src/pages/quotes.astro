---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tendril from '../components/Tendril.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { featuredQuote, isDevanagari } from '../lib/garden';

const featured = await featuredQuote();
const rest = (await getCollection('quotes')).filter((q) => !q.data.featured).sort((a, b) => b.data.added.getTime() - a.data.added.getTime());
const poems = (await getCollection('poems')).sort((a, b) => a.data.order - b.data.order);
const deva = featured ? isDevanagari(featured.data.original) : false;
// Couplets read better on two lines: break after the first full stop (।).
const lines = featured ? featured.data.original.split(/(?<=।)\s+/) : [];
---

<Base title="Quotes" description="Why do certain quotes stay with us for years? Perhaps the beauty of a quote lies in how much it says with so little." devanagari kannada>
  <section class="page-top intro">
    <h1 class="h1">Quotes</h1>
    <p class="lede">
      Why do certain quotes stay with us for years? Perhaps the beauty of a quote lies in how much it says with so
      little. It captures a thought succinctly but leaves enough room for us to make it our own.
    </p>
  </section>

  {
    featured && (
      <section class="featured">
        <p class:list={['f-original', { deva }]} lang={deva ? 'hi' : undefined}>
          {lines.map((l, i) => (
            <>
              {i > 0 && <br />}
              {l}
            </>
          ))}
        </p>
        {featured.data.translation && <p class="f-translation">{featured.data.translation}</p>}
        <p class="f-source">{featured.data.source}</p>
        {featured.data.why && <p class="f-why">{featured.data.why}</p>}
      </section>
    )
  }

  {
    rest.length > 0 && (
      <>
        <div class="divider"><Tendril width={560} /></div>
        <section class="grid" aria-label="More quotes">
          {rest.map((q) => (
            <QuoteCard quote={q} />
          ))}
        </section>
      </>
    )
  }

  {
    poems.length > 0 && (
      <section class="poems" aria-labelledby="poems-h">
        <h2 class="h2" id="poems-h">Poems</h2>
        {poems.map((p) => (
          <article class="kw-card poem">
            <h3 class="poem-title">{p.data.title}</h3>
            {p.data.stanzas.map((st) => (
              <p class="stanza">
                {st.split('\n').map((l, i) => (
                  <>
                    {i > 0 && <br />}
                    {l}
                  </>
                ))}
              </p>
            ))}
            {p.data.why && (
              <p class="poem-why">
                <span class="label">Why I keep it</span>
                {p.data.why}
              </p>
            )}
          </article>
        ))}
      </section>
    )
  }
</Base>

<style>
  .intro {
    max-width: 40rem;
  }
  .featured {
    max-width: 48rem;
    margin: clamp(64px, 9vw, 104px) 0;
  }
  .f-original {
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-size: clamp(26px, 3.4vw, 36px);
    line-height: 1.45;
  }
  .f-original.deva {
    font-family: var(--font-deva);
    font-size: clamp(28px, 3.8vw, 40px);
    line-height: 1.65;
  }
  .f-translation {
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'SOFT' 40;
    font-style: italic;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.4;
  }
  .f-source {
    margin-bottom: 14px;
    font-size: 15px;
    color: var(--muted);
  }
  .f-why {
    max-width: 34em;
    font-size: 16.5px;
  }
  .divider {
    margin-bottom: clamp(48px, 7vw, 72px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 20px;
    align-items: start;
  }
  .poems {
    margin-top: clamp(72px, 10vw, 112px);
  }
  .poem {
    max-width: 34rem;
    margin-top: 32px;
    padding: 32px 32px 22px;
    background: var(--paper-lift);
    border: 1px solid var(--hair);
  }
  .poem-title {
    margin-bottom: 28px;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'SOFT' 40;
    font-weight: 500;
    font-size: 24px;
    line-height: 1.2;
  }
  .stanza {
    margin-bottom: 22px;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24, 'SOFT' 40;
    font-size: 21px;
    line-height: 1.5;
  }
  .poem-why {
    margin-top: 36px;
    padding-top: 14px;
    border-top: 1px solid var(--hair);
    font-size: 16.5px;
  }
  @media (max-width: 480px) {
    .poem {
      padding: 24px 20px 16px;
    }
    .stanza {
      font-size: 18.5px;
    }
    .stanza {
      padding-left: 1.2em;
      text-indent: -1.2em;
    }
  }
  .poem-why .label {
    display: block;
    margin-bottom: 4px;
  }
</style>
