<script>
  // Walk the J / Walk the K: reset the paths, then reveal the chosen letter's dots.
  const mark = document.querySelector<SVGElement>('.why .mark');
  const walkButtons = document.querySelectorAll<HTMLButtonElement>('.why [data-walk-to]');
  walkButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const to = b.dataset.walkTo!;
      walkButtons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      if (!mark) return;
      mark.setAttribute('data-walk', 'none');
      // Flush styles so the dots are hidden again before the walk starts from the beginning.
      mark.querySelectorAll('.rev').forEach((p) => getComputedStyle(p).strokeDashoffset);
      if (to !== 'none') mark.setAttribute('data-walk', to);
    })
  );

  // It took six tries: one try on show at a time, picked from the list or stepped through.
  const slides = [...document.querySelectorAll<HTMLElement>('.why .slide')];
  const picks = [...document.querySelectorAll<HTMLButtonElement>('.why [data-pick]')];
  const [prev, next] = [...document.querySelectorAll<HTMLButtonElement>('.why [data-step]')];
  let current = 1;
  const show = (n: number) => {
    current = Math.min(slides.length, Math.max(1, n));
    slides.forEach((s) => (s.hidden = s.dataset.try !== String(current)));
    picks.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.pick === String(current))));
    prev?.setAttribute('aria-disabled', String(current === 1));
    next?.setAttribute('aria-disabled', String(current === slides.length));
  };
  picks.forEach((p) => p.addEventListener('click', () => show(Number(p.dataset.pick))));
  prev?.addEventListener('click', () => show(current - 1));
  next?.addEventListener('click', () => show(current + 1));
</script>

