---
// Why it looks like this: the logo story, what the garden is about, what it's made of, and the rules.
// The copy is Claude's draft for Kavya to edit (the mockup says so in a banner; the page doesn't).
// The walkable mark inlines the logo's paths so the dotted paths can be masked and walked.
import Base from '../layouts/Base.astro';
import { recentlyTended, shortDate } from '../lib/garden';

/** When this page last changed. Update it when you edit the page. */
const TENDED = '2026-10-15';
const tended = new Date(TENDED);
const deva = 'धीरे-धीरे रे मना, धीरे सब कुछ होय। माली सींचे सौ घड़ा, ऋतु आए फल होय।';
---

