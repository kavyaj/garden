---
// The reverse bucket list: things already done, in groups, each with a green tick that redraws on hover.
// Entries still in [square brackets] are Kavya's placeholders and don't render; a [year] shows no year.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tendril from '../components/Tendril.astro';

const placeholder = (s?: string | null) => !s || /\[[^\]]*\]/.test(s);
const entries = (await getCollection('done'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((e) => !placeholder(e.data.title));
const groups = [...new Set(entries.map((e) => e.data.group))].map((g) => ({
  name: g,
  items: entries.filter((e) => e.data.group === g),
}));
const ticked = `${entries.length} ticked`;
---

<Base title="The reverse bucket list" description="Things I've already done, ticked, and don't want to forget." width="list">
  <section class="page-top">
    <h1 class="h1">The reverse bucket list</h1>
    <p class="lede">
      A bucket list points forward, and mostly makes you feel behind. This one points back: things I've already done,
      ticked, and don't want to forget.
    </p>
    <p class="so-far">{ticked}, so far. Newest at the top of each group.</p>
  </section>

  {
    groups.map((g) => (
      <section class="group" aria-label={g.name}>
        <h2 class="label">{g.name}</h2>
        <ul>
          {g.items.map((e) => (
            <li class="done">
              <svg viewBox="0 0 22 22" aria-hidden="true">
                <rect x="1" y="1" width="20" height="20" fill="#FBFAF6" stroke="rgba(26,25,22,0.35)" stroke-width="1.2" />
                <path class="tick" pathLength="1" d="M4.5 11.5 C6.5 13 8 15 9 17.5 C11.5 11 15 6 21 1.5" />
              </svg>
              <span class="text">
                <span class="title">{e.data.title}</span>
                {!placeholder(e.data.story) && <span class="story">{e.data.story}</span>}
              </span>
              {!placeholder(e.data.year) && <span class="year">{e.data.year}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <div class="end">
    <Tendril width={340} />
    <p class="muted">Still adding.</p>
  </div>
</Base>

<style>
  .lede {
    max-width: 32em;
    margin-bottom: 14px;
  }
  .so-far {
    font-size: 15px;
    color: var(--muted);
  }
  .group {
    margin-top: 52px;
  }
  .group .label {
    margin-bottom: 8px;
  }
  ul {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--hair);
  }
  li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 16px 0 17px;
    border-top: 1px solid var(--hair);
  }
  li svg {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 5px;
    overflow: visible;
  }
  .tick {
    fill: none;
    stroke: var(--green);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .done:hover .tick {
    animation: retick 0.5s ease;
  }
  @keyframes retick {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .title {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 36, 'SOFT' 40;
    font-weight: 500;
    font-size: 21px;
    line-height: 1.3;
  }
  .story {
    display: block;
    margin-top: 3px;
    font-size: 15.5px;
    color: var(--muted);
  }
  .year {
    flex: none;
    padding-top: 5px;
    font-size: 14px;
    color: var(--muted);
  }
  .end {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 6px 28px;
    margin-top: 40px;
  }
  .end > :global(.kw-vine) {
    flex: 0 1 340px;
  }
  .end p {
    margin-bottom: 6px;
    font-size: 15px;
  }
</style>
