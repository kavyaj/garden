---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MapPlan from '../components/MapPlan.astro';
import { notesByTended, recentlyTended, iso, fullDate, plural, count } from '../lib/garden';
import { plots } from '../site';

const notes = await notesByTended();
const quotes = await getCollection('quotes');
const songs = await getCollection('songs');
const books = await getCollection('books');
const chapters = await getCollection('chapters');
const projects = await getCollection('projects');
// The reverse bucket list only counts real entries: titles still in [square brackets] are placeholders.
const done = (await getCollection('done')).filter((e) => !/\[[^\]]*\]/.test(e.data.title));
const counts: Record<string, number> = {
  notes: notes.length,
  quotes: quotes.length,
  songs: songs.length,
  books: books.length,
  done: done.length,
  chapters: chapters.length,
  projects: projects.length,
};
const fresh = notes.filter((n) => recentlyTended(n.data.tended)).length;
const kinds = (k: string) => projects.filter((p) => p.data.kind === k).length;

// The line under each planted plot's name.
const subs: Record<string, string> = {
  home: 'home',
  about: 'the shed',
  notes: fresh ? `${notes.length}, ${fresh} tended lately` : plural(notes.length, 'note'),
  quotes: `${quotes.length} in the pond`,
  songs: plural(songs.length, 'song'),
  made: `${kinds('run')} run, ${kinds('written')} written, ${kinds('small')} small`,
  books: `${books.length} that moved me`,
  done: `${done.length} ticked`,
  thatha: 'a book, unfinished',
};
const lastTended = notes[0]?.data.tended;
const isPlanted = (p: (typeof plots)[number]) => !p.collection || (counts[p.collection] ?? 0) > 0;
const line = (s: string) => s.replace('{songs}', count(songs.length, 'song'));
---

<Base title="The map" description="Everything on this site, drawn as one plot." width="map">
  <section class="page-top intro">
    <h1 class="h1">The garden, from above.</h1>
    <p class="lede">Everything on this site, drawn as one plot. Wander if you like. The dotted beds are things I haven't planted yet.</p>
  </section>

  <section class="plan-wrap">
    <MapPlan counts={counts} fresh={fresh} subs={subs} />
    <p class="census">
      {[
        plural(notes.length, 'note'),
        plural(quotes.length, 'quote'),
        plural(songs.length, 'song'),
        plural(books.length, 'book'),
        `${plural(done.length, 'thing')} done`,
        `${plural(projects.length, 'thing')} made.`,
      ].join(', ')}{' '}
      {lastTended && <>Last tended <time datetime={iso(lastTended)} data-rel>{fullDate(lastTended)}</time>.</>}
    </p>
  </section>

  <section class="plain" aria-labelledby="plain-h">
    <h2 class="h2" id="plain-h">The same garden, as a list</h2>
    <ul>
      {
        plots.map((p) => (
          <li>
            <span class="name">{isPlanted(p) ? <a class="kw-ul" href={p.href}>{p.listLabel ?? p.label}</a> : p.listLabel ?? p.label}</span>
            <span class="muted">{isPlanted(p) ? line(p.list) : `Later. ${line(p.list)}`}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .intro {
    max-width: 40rem;
  }
  .plan-wrap {
    margin-top: 48px;
  }
  .census {
    margin-top: 14px;
    font-size: 14px;
    color: var(--muted);
  }
  .plain {
    max-width: 46rem;
    margin-top: 72px;
  }
  .plain .h2 {
    font-size: 22px;
    margin-bottom: 8px;
  }
  ul {
    list-style: none;
    padding: 0;
    font-size: 16px;
    border-bottom: 1px solid var(--hair);
  }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 16px;
    padding: 2px 0;
    border-top: 1px solid var(--hair);
  }
  .name {
    flex: 0 0 11rem;
    padding: 10px 0;
  }
  .name a {
    display: inline-block;
    padding: 10px 0;
    margin: -10px 0;
    background-position: 0 calc(100% - 10px);
  }
  li .muted {
    flex: 1 1 18rem;
    padding-bottom: 10px;
  }
</style>
