---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Backlinks from '../../components/Backlinks.astro';
import TendrilLink from '../../components/TendrilLink.astro';
import Highlighted from '../../components/Highlighted.astro';
import { notesByTended, recentlyTended, readingTime, backlinks, iso, fullDate, monthYear } from '../../lib/garden';

export async function getStaticPaths() {
  const notes = await notesByTended();
  const links = await backlinks();
  return notes.map((note, i) => ({
    params: { slug: note.id },
    // "Next" walks down the list: the next one tended before this.
    props: { note, next: notes[i + 1], mentionedIn: links.get(note.id) ?? [] },
  }));
}
const { note, next, mentionedIn } = Astro.props;
const { Content } = await render(note);
const d = note.data;
---

<Base title={d.title} description={d.summary}>
  <article class="page-top">
    <p class="crumb"><a class="kw-ul" href="/notes">Notes</a></p>
    <h1 class="h1 title">{d.title}</h1>
    <p class="meta">
      Planted {monthYear(d.planted)} ·{' '}
      {recentlyTended(d.tended) && <span class="dot" />}Last tended <time datetime={iso(d.tended)}>{fullDate(d.tended)}</time> · {readingTime(note.body)}
    </p>

    <div class="cols">
      <div class="body">
        <Highlighted phrase={d.highlight}><Content /></Highlighted>
      </div>
      {
        d.margin && (
          <aside class="margin">
            <p>{d.margin}</p>
          </aside>
        )
      }
    </div>

    <Backlinks notes={mentionedIn} />

    <nav class="more" aria-label="More notes">
      <TendrilLink href="/notes">All notes</TendrilLink>
      {
        next && (
          <a class="kw-row next" href={`/notes/${next.id}`}>
            <span class="muted next-label">Next</span>
            <span class="kw-t">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .crumb {
    margin-bottom: 20px;
    font-size: 14px;
  }
  .crumb a {
    display: inline-block;
    padding: 12px 0;
    background-position: 0 calc(100% - 12px);
  }
  .title {
    max-width: 15em;
    font-size: clamp(40px, 5.6vw, 60px);
    line-height: 1.02;
  }
  .meta {
    margin-bottom: 48px;
    font-size: 14px;
    color: var(--muted);
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 56px;
    align-items: flex-start;
  }
  .body {
    flex: 1 1 34rem;
    max-width: var(--measure-text);
    min-width: 0;
    font-size: 18.5px;
    line-height: 1.7;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol),
  .body :global(blockquote) {
    margin: 0 0 22px;
  }
  .body :global(h2) {
    margin: 44px 0 14px;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'SOFT' 40;
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: 26px;
  }
  .body :global(h3) {
    margin: 32px 0 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
  }
  .body :global(a) {
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(var(--spot), var(--spot)) 0 100% / 100% 2px no-repeat;
    padding-bottom: 2px;
  }
  .body :global(blockquote) {
    padding-left: var(--space-4);
    border-left: 2px solid var(--hair);
    color: var(--muted);
  }
  /* A quoted tweet: a quiet card, never a screenshot (see src/lib/prose.ts). */
  .body :global(.tweet) {
    max-width: 30rem;
    margin: 8px 0 30px;
    padding: 20px 22px 16px;
    background: var(--paper-lift);
    border: 1px solid var(--hair);
  }
  .body :global(.tweet-by) {
    margin: 0 0 10px;
    font-size: 15px;
  }
  .body :global(.tweet-name) {
    font-weight: 600;
  }
  .body :global(.tweet-handle) {
    color: var(--muted);
  }
  .body :global(.tweet blockquote) {
    margin: 0 0 12px;
    padding: 0;
    border: 0;
    color: var(--ink);
    font-size: 17px;
    line-height: 1.55;
  }
  .body :global(.tweet blockquote p) {
    margin: 0;
  }
  .body :global(.tweet figcaption) {
    font-size: 13.5px;
    color: var(--muted);
  }
  .body :global(.tweet figcaption a) {
    color: var(--muted);
  }
  .body :global(img) {
    display: block;
    height: auto;
  }
  /* The one margin note: in the margin on wide screens, after the body on phones. */
  .margin {
    flex: 0 1 13rem;
    min-width: 0;
    padding-top: 196px;
  }
  .margin p {
    font-family: var(--font-hand);
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .margin {
      flex-basis: 100%;
      padding-top: 0;
      max-width: var(--measure-text);
    }
  }
  .more {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    max-width: var(--measure-text);
    margin-top: 48px;
    font-size: 15px;
  }
  .next {
    text-align: right;
  }
  .next-label {
    display: block;
    font-size: 13px;
  }
</style>
