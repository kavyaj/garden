---
import Base from '../../layouts/Base.astro';
import NoteList from '../../components/NoteList.astro';
import Tendril from '../../components/Tendril.astro';
import { notesByTended } from '../../lib/garden';

const notes = await notesByTended();
// Grouped by the year each note was last tended, newest first.
const years = [...new Set(notes.map((n) => n.data.tended.getUTCFullYear()))];
---

<Base title="Notes" description="Everything I'm thinking through, sorted by when I last touched it." width="list">
  <section class="page-top">
    <h1 class="h1">Notes</h1>
    <p class="lede">
      Writing gives me clarity. It sort of forces me to make sense of my thoughts when I pen them down. Here are some
      thoughts that saw the light of day.
    </p>
  </section>

  {
    years.map((y) => (
      <section class="year" aria-labelledby={`y${y}`}>
        <h2 class="label" id={`y${y}`}>
          {y}
        </h2>
        <NoteList notes={notes.filter((n) => n.data.tended.getUTCFullYear() === y)} />
      </section>
    ))
  }

  <div class="end">
    <Tendril width={360} class="end-vine" />
    <p class="muted">{notes.length ? "That's everything, for now." : 'Nothing planted yet.'}</p>
  </div>
</Base>

<style>
  .year {
    margin-top: 48px;
  }
  .year .label {
    margin-bottom: 8px;
  }
  .end {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 6px 16px;
    margin-top: 40px;
  }
  .end :global(.end-vine) {
    flex: 0 1 360px;
  }
  .end p {
    margin-bottom: 6px;
    font-size: 15px;
  }
</style>
