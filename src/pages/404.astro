---
import Base from '../layouts/Base.astro';
import Tendril from '../components/Tendril.astro';
import TendrilLink from '../components/TendrilLink.astro';
---

<Base title="Not grown yet" description="This page hasn't grown yet.">
  <section class="page-top lost">
    <h1 class="h1">This one hasn't grown yet.</h1>
    <Tendril width={420} short class="vine" />
    <p class="lede">Either the link's wrong or I haven't planted it. The map shows what's actually here.</p>
    <TendrilLink href="/map">See the map</TendrilLink>
  </section>
</Base>

<style>
  .lost {
    max-width: 40rem;
  }
  .vine {
    margin: 8px 0 28px;
  }
  .lede {
    margin-bottom: 12px;
  }
</style>
