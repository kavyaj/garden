---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GateIllustration from '../components/GateIllustration.astro';
import Tendril from '../components/Tendril.astro';
import TendrilLink from '../components/TendrilLink.astro';
import NoteList from '../components/NoteList.astro';
import { notesByTended, featuredQuote, isDevanagari, count } from '../lib/garden';
import { site } from '../site';

const recent = (await notesByTended()).slice(0, 4);
const quote = await featuredQuote();
const songs = (await getCollection('songs')).sort((a, b) => a.data.order - b.data.order);
const song = songs[0];
const more = songs.length - 1;
const run = (await getCollection('projects')).filter((p) => p.data.kind === 'run').sort((a, b) => a.data.order - b.data.order);
// Home can show an excerpt of the featured quote.
const qOriginal = quote ? (quote.data.home?.original ?? quote.data.original) : '';
const qTranslation = quote ? (quote.data.home?.translation ?? quote.data.translation) : '';
const deva = isDevanagari(qOriginal);
// The tagline, with its second sentence highlighted.
const [tag1, ...tagRest] = site.tagline.split(/(?<=\.)\s+/);
---

<Base description="Hi, I'm Kavya. This is my little corner on the internet where I share and nurture ideas and projects that are close to my heart." devanagariText={deva ? qOriginal : undefined}>
  <section class="hero">
    <div class="hero-text">
      <h1 class="h1 home-h1">Everyone has a story to tell.</h1>
      <p class="big last">
        And this is mine. Hi, I'm Kavya. This is my little corner on the internet where I share and nurture ideas and
        projects that are close to my heart.
      </p>
      <p class="aside">{tag1} <span class="hl">{tagRest.join(' ')}</span></p>
    </div>
    <GateIllustration />
  </section>

  <div class="divider"><Tendril width={620} /></div>

  <section>
    <div class="section-head">
      <h2 class="h2">Recently tended</h2>
      <TendrilLink href="/notes">All notes</TendrilLink>
    </div>
    {recent.length ? <NoteList notes={recent} variant="home" /> : <p class="muted">Nothing planted yet.</p>}
  </section>

  {
    quote && (
      <section class="featured">
        <p class="label">Six hundred years old. Still right.</p>
        <p class:list={['q-original', { deva }]} lang={deva ? 'hi' : undefined}>
          {qOriginal}
        </p>
        {qTranslation && <p class="q-translation">{qTranslation}</p>}
        <p class="q-source">
          {quote.data.source} · <TendrilLink href="/quotes">More quotes</TendrilLink>
        </p>
      </section>
    )
  }

  <section class="pair">
    {
      song && (
        <div class="col">
          <h2 class="h2 small-h2">On repeat</h2>
          <a class="kw-row record" href="/on-repeat">
            <span class="mp3" aria-hidden="true">
              <svg viewBox="0 0 120 40"><rect x="4" y="2" width="114" height="36" rx="18" fill="#2E58A6"></rect><rect x="4" y="31" width="114" height="7" rx="3.5" fill="#C9CED6"></rect><rect x="4" y="2" width="114" height="31" rx="15.5" fill="#2E58A6"></rect><path d="M93 3 V37" stroke="#21417F" stroke-width="1.5"></path><rect x="21" y="8" width="64" height="22" rx="11" fill="#151619"></rect><circle cx="31.5" cy="19" r="6.5" fill="#D9DCE1"></circle><path d="M30 16.5 L34 19 L30 21.5Z" fill="#1A1916"></path><rect x="42" y="13.5" width="30" height="11" rx="1.5" fill="#BFD0BC"></rect><path d="M45 19 H66" stroke="#2A3326" stroke-width="2" stroke-dasharray="2 1.5"></path><circle cx="1.5" cy="20" r="3" fill="none" stroke="#9EA4AD" stroke-width="1.6"></circle></svg>
            </span>
            <span>
              <span class="kw-t rec-title">{song.data.title}</span>
              <span class="rec-sub">{song.data.artist}{more > 0 ? `, and ${count(more, 'more', 'more').replace(/ more$/, '').toLowerCase()} more.` : '.'}</span>
            </span>
          </a>
        </div>
      )
    }
    <div class="col">
      <h2 class="h2 small-h2 made-h">Things I've made</h2>
      <ul class="made">
        {
          run.slice(0, 2).map((p) => (
            <li>
              <a class="kw-ul" href={p.data.url}>
                {p.data.title}
              </a>{' '}
              <span class="muted">{p.data.short ?? p.data.blurb}</span>
            </li>
          ))
        }
        <li><TendrilLink href="/made">and a few small things</TendrilLink></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 56px;
    padding: clamp(56px, 9vw, 112px) 0 clamp(56px, 8vw, 96px);
  }
  .hero-text {
    flex: 999 1 26rem;
    min-width: 0;
  }
  .home-h1 {
    font-size: clamp(46px, 7.2vw, 80px);
    line-height: 0.98;
    margin-bottom: 28px;
  }
  .big {
    max-width: 28em;
    margin-bottom: 6px;
    font-size: 20px;
    line-height: 1.5;
  }
  .big.last {
    margin-bottom: 28px;
  }
  .aside {
    max-width: 30em;
    font-family: var(--font-hand);
    font-size: 20px;
    line-height: 1.5;
    color: var(--muted);
  }
  .divider {
    margin: 0 0 clamp(48px, 7vw, 72px);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 10px;
  }
  .section-head :global(.kw-tl) {
    font-size: 15px;
  }

  .featured {
    max-width: 46rem;
    margin-top: clamp(88px, 12vw, 140px);
  }
  .featured .label {
    margin-bottom: 20px;
  }
  .q-original {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.4;
  }
  .q-original.deva {
    font-family: var(--font-deva);
    font-size: clamp(26px, 3.4vw, 36px);
    line-height: 1.7;
  }
  .q-translation {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 36, 'SOFT' 40;
    font-style: italic;
    font-size: clamp(21px, 2.4vw, 26px);
    line-height: 1.4;
  }
  .q-source {
    font-size: 15px;
    color: var(--muted);
  }

  .pair {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
    margin-top: clamp(88px, 12vw, 140px);
  }
  .col {
    flex: 1 1 18rem;
    min-width: 0;
  }
  .small-h2 {
    font-size: 22px;
    margin-bottom: 16px;
  }
  .made-h {
    margin-bottom: 12px;
  }
  .record {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .mp3 {
    flex: none;
    width: 96px;
  }
  .mp3 svg {
    display: block;
    width: 96px;
    height: auto;
    overflow: visible;
  }
  .rec-title {
    font-weight: 600;
  }
  .rec-sub {
    display: block;
    font-size: 15px;
    color: var(--muted);
  }
  .made {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
  }
  /* Inline links, but still a 44px target. */
  .made a.kw-ul {
    display: inline-block;
    padding: 11px 0;
    margin: -11px 0;
    background-position: 0 calc(100% - 11px);
  }
</style>
