---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GateIllustration from '../components/GateIllustration.astro';
import Tendril from '../components/Tendril.astro';
import TendrilLink from '../components/TendrilLink.astro';
import NoteList from '../components/NoteList.astro';
import { notesByTended, featuredQuote, isDevanagari } from '../lib/garden';
import { sleeve } from '../sleeves';

const recent = (await notesByTended()).slice(0, 4);
const quote = await featuredQuote();
const records = (await getCollection('records')).sort((a, b) => b.data.added.getTime() - a.data.added.getTime());
const record = records[0];
const run = (await getCollection('projects')).filter((p) => p.data.kind === 'run').sort((a, b) => a.data.order - b.data.order);
const deva = quote ? isDevanagari(quote.data.original) : false;
---

<Base description="Kavya Jahagirdar's digital garden: the thinking that doesn't fit on LinkedIn." devanagariText={deva ? quote!.data.original : undefined}>
  <section class="hero">
    <div class="hero-text">
      <h1 class="h1 home-h1">A garden I tend in public.</h1>
      <p class="big">I build things that help people explain their careers better.</p>
      <p class="big last">I write about things I'm <span class="hl">still figuring out</span>.</p>
      <p class="aside">This is where I put the thinking that doesn't fit on LinkedIn.</p>
    </div>
    <GateIllustration />
  </section>

  <Tendril width={620} class="divider" />

  <section>
    <div class="section-head">
      <h2 class="h2">Recently tended</h2>
      <TendrilLink href="/notes">All notes</TendrilLink>
    </div>
    {recent.length ? <NoteList notes={recent} variant="home" /> : <p class="muted">Nothing planted yet.</p>}
  </section>

  {
    quote && (
      <section class="featured">
        <p class="label">A line I keep coming back to</p>
        <p class:list={['q-original', { deva }]} lang={deva ? 'hi' : undefined}>
          {quote.data.original}
        </p>
        {quote.data.translation && <p class="q-translation">{quote.data.translation}</p>}
        <p class="q-source">
          {quote.data.source} · <TendrilLink href="/quotes">More quotes</TendrilLink>
        </p>
      </section>
    )
  }

  <section class="pair">
    {
      record && (
        <div class="col">
          <h2 class="h2 small-h2">On repeat</h2>
          <a class="kw-row record" href="/on-repeat">
            <span class="sleeve" aria-hidden="true">
              <svg viewBox="0 0 100 100" set:html={sleeve(record.data.sleeve)} />
            </span>
            <span>
              <span class="kw-t rec-title">{record.data.title}</span>
              <span class="rec-sub">
                {record.data.artist}.{record.data.note && ` ${record.data.note}`}
              </span>
            </span>
          </a>
        </div>
      )
    }
    <div class="col">
      <h2 class="h2 small-h2 made-h">Things I've made</h2>
      <ul class="made">
        {
          run.slice(0, 2).map((p) => (
            <li>
              <a class="kw-ul" href={p.data.url}>
                {p.data.title}
              </a>{' '}
              <span class="muted">{p.data.short ?? p.data.blurb}</span>
            </li>
          ))
        }
        <li><TendrilLink href="/made">and a few small things</TendrilLink></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 56px;
    padding: clamp(56px, 9vw, 112px) 0 clamp(56px, 8vw, 96px);
  }
  .hero-text {
    flex: 999 1 26rem;
    min-width: 0;
  }
  .home-h1 {
    font-size: clamp(46px, 7.2vw, 80px);
    line-height: 0.98;
    margin-bottom: 28px;
  }
  .big {
    max-width: 28em;
    margin-bottom: 6px;
    font-size: 20px;
    line-height: 1.5;
  }
  .big.last {
    margin-bottom: 28px;
  }
  .aside {
    max-width: 30em;
    font-size: 15px;
    color: var(--muted);
  }
  .divider {
    margin: 0 0 clamp(48px, 7vw, 72px);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 10px;
  }
  .section-head :global(.kw-tl) {
    font-size: 15px;
  }

  .featured {
    max-width: 46rem;
    margin-top: clamp(88px, 12vw, 140px);
  }
  .featured .label {
    margin-bottom: 20px;
  }
  .q-original {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.4;
  }
  .q-original.deva {
    font-family: var(--font-deva);
    font-size: clamp(26px, 3.4vw, 36px);
    line-height: 1.7;
  }
  .q-translation {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 36, 'SOFT' 40;
    font-style: italic;
    font-size: clamp(21px, 2.4vw, 26px);
    line-height: 1.4;
  }
  .q-source {
    font-size: 15px;
    color: var(--muted);
  }

  .pair {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
    margin-top: clamp(88px, 12vw, 140px);
  }
  .col {
    flex: 1 1 18rem;
    min-width: 0;
  }
  .small-h2 {
    font-size: 22px;
    margin-bottom: 16px;
  }
  .made-h {
    margin-bottom: 12px;
  }
  .record {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .sleeve {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    background: var(--paper-lift);
    border: 1px solid var(--hair);
  }
  .sleeve svg {
    width: 60px;
    height: 60px;
  }
  .rec-title {
    font-weight: 600;
  }
  .rec-sub {
    display: block;
    font-size: 15px;
    color: var(--muted);
  }
  .made {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
  }
</style>
