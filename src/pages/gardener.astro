---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import Base from '../layouts/Base.astro';
import TendrilButton from '../components/TendrilButton.astro';
import { site } from '../site';

const growing = (await getCollection('growing')).sort((a, b) => a.data.order - b.data.order);
const made = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// The vine down "Small things I've made": one segment per row, each with a coil reaching right.
// Alternating waves, a leaf on the first and last rows, and the last row ends in a double coil.
const tilts = [-2.5, 2, -1.5, 1.8, -2];
const waves = ['M26 0 C19 22 33 46 25 70 C20 84 28 92 25 100', 'M25 0 C31 24 18 46 26 70 C31 84 22 92 25 100'];
---

<Base title="The Gardener" description="Who tends this garden, what I'm growing, and the small things I've made." strip="gardener">
  <section class="about">
    <div class="about-text">
      <p class="kicker">curly hair, many tabs open</p>
      <h1 class="kw-display">The Gardener</h1>
      <div class="bio">
        <p>
          I'm Kavya Jahagirdar. I live in Singapore, studied engineering at NTU with a minor in entrepreneurship, and
          since 2019 I've been building things that help people explain their careers better than a résumé template
          lets them.
        </p>
        <p>
          I also wrote a children's picture book, which turned out to be the best writing training I've ever had.
          Six-year-olds don't skim. They just leave.
        </p>
        <p>
          This garden is where I put the thinking that doesn't fit on LinkedIn: half-ideas, things I've changed my mind
          about, and words I keep returning to.
        </p>
      </div>
    </div>
    <figure class="portrait">
      <span class="kw-polaroid frame">
        <Image
          src={portrait}
          alt="Kavya smiling, in a pink floral dress, among plants and garden chairs in black and white"
          width={544}
          widths={[272, 544]}
          sizes="272px"
          format="webp"
          quality={80}
          loading="eager"
        />
      </span>
      <figcaption>the gardener, mid-thought</figcaption>
    </figure>
  </section>

  <section class="block" aria-labelledby="growing-h">
    <h2 id="growing-h" class="kw-heading rule">What I'm growing</h2>
    <div class="growing">
      {
        growing.map((g) =>
          g.data.url ? (
            <a class="grow" href={g.data.url}>
              <span class="kw-subheading grow-title">{g.data.title}</span>
              <span class="grow-blurb">{g.data.blurb}</span>
            </a>
          ) : (
            <div class="grow">
              <span class="kw-subheading grow-title">{g.data.title}</span>
              <span class="grow-blurb">{g.data.blurb}</span>
            </div>
          )
        )
      }
    </div>
  </section>

  {
    made.length > 0 && (
      <section class="block" aria-labelledby="made-h">
        <div class="rule made-head">
          <h2 id="made-h" class="kw-heading">
            Small things I've made
          </h2>
          <span class="made-aside">weekend projects, mostly for people I like</span>
        </div>
        <div class="made">
          {made.map((p, i) => {
            const last = i === made.length - 1;
            return (
              <div class="made-row" style={`--d:${0.2 + i * 0.8}s`}>
                <div class="vine-col" aria-hidden="true">
                  {last ? (
                    <svg class="vine-seg vine-seg--half" viewBox="0 0 50 50" preserveAspectRatio="none">
                      <path class="vine" pathLength="1" vector-effect="non-scaling-stroke" d="M25 0 C19 18 31 34 25 50" />
                    </svg>
                  ) : (
                    <svg class="vine-seg" viewBox="0 0 50 100" preserveAspectRatio="none">
                      <path class="vine" pathLength="1" vector-effect="non-scaling-stroke" d={waves[i % 2]} />
                    </svg>
                  )}
                  <svg class="vine-coil" viewBox="0 0 50 40">
                    <path class="vcoil" pathLength="1" d="M25 20 C34 18 44 20 46 27 C48 34 40 36 38 31" />
                    {last && made.length > 1 && (
                      <path class="vcoil" pathLength="1" d="M25 20 C24 30 14 34 10 28 C6 22 13 18 16 23" />
                    )}
                    {i === 0 && <path class="vleaf" d="M26 14 C30 6 38 4 44 7 C40 13 33 16 26 14Z" />}
                    {last && i > 0 && <path class="vleaf" d="M24 22 C20 30 12 32 6 30 C10 24 17 21 24 22Z" />}
                  </svg>
                </div>
                <div class="prow">
                  {p.data.image && (
                    <a class="thumb" href={p.data.url} tabindex="-1" aria-hidden="true" style={`--r:${tilts[i % tilts.length]}deg`}>
                      <Image src={p.data.image} alt="" width={360} widths={[180, 360]} sizes="180px" format="webp" quality={78} loading="lazy" />
                    </a>
                  )}
                  <a class="made-text" href={p.data.url}>
                    <span class="made-title">{p.data.title}</span>
                    <span class="made-blurb">{p.data.blurb}</span>
                    <span class="made-cta">{p.data.cta}</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="kw-slab terms" aria-labelledby="terms-h">
    <p class="terms-kicker">before you wander in</p>
    <h2 id="terms-h" class="kw-heading">Terms of the garden</h2>
    <div class="terms-body">
      <p>
        Everything here is a work in progress, including me. I reserve the right to be wrong, and to change my mind in
        public. Notes get rewritten without warning, and the dates show when.
      </p>
      <p>
        If something here helps you, borrow it, and say where it came from. If something's wrong, tell me. That's the
        whole point of tending things where people can see.
      </p>
    </div>
  </section>

  <section class="hello">
    <p>Say hello. I read everything, slowly.</p>
    <div class="hello-links">
      {
        site.socials.map((s) => (
          <TendrilButton href={s.href} variant="secondary">
            {s.label}
          </TendrilButton>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: flex-start;
    padding-top: clamp(32px, 6vw, 72px);
  }
  .about-text {
    flex: 999 1 26rem;
    min-width: 0;
  }
  .kicker {
    margin-bottom: 6px;
    font-family: var(--font-hand);
    font-size: 18px;
    color: var(--moss);
    transform: rotate(var(--tilt-m));
    transform-origin: left;
  }
  h1 {
    margin-bottom: var(--space-5);
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .bio {
    max-width: var(--measure-text);
    font-size: 17px;
    line-height: 1.72;
  }
  .bio p + p {
    margin-top: 18px;
  }

  .portrait {
    flex: 1 1 15rem;
    max-width: 17rem;
    margin: 8px 0 0;
  }
  .frame {
    display: block;
    padding-bottom: 44px;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  figcaption {
    margin-top: 14px;
    font-family: var(--font-hand);
    font-size: 15px;
    color: var(--moss);
    transform: rotate(-1deg);
  }

  .block {
    margin-top: clamp(56px, 8vw, 96px);
  }
  .rule {
    padding-top: 18px;
    border-top: 2px solid var(--ink);
  }
  .block h2 {
    font-size: clamp(26px, 3.4vw, 36px);
  }
  #growing-h {
    margin-bottom: var(--space-2);
  }
  .growing {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 0 40px;
  }
  .grow {
    display: block;
    padding: 18px 0;
    border-bottom: 1px solid var(--ink-hair);
    color: var(--ink);
    text-decoration: none;
  }
  .grow-title {
    display: block;
    font-size: 21px;
  }
  a.grow:hover .grow-title {
    text-decoration: underline;
    text-decoration-color: var(--spot);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .grow-blurb {
    display: block;
    font-size: 15px;
    line-height: 1.55;
    color: var(--moss);
  }

  .made-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px var(--space-4);
    margin-bottom: 20px;
  }
  .made-aside {
    font-family: var(--font-hand);
    font-size: 16px;
    color: var(--moss);
    transform: rotate(-1.2deg);
  }
  .made {
    display: flex;
    flex-direction: column;
  }
  .made-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 0 12px;
  }
  .vine-col {
    position: relative;
  }
  .vine-seg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .vine-seg--half {
    bottom: auto;
    height: 50%;
  }
  .vine-coil {
    position: absolute;
    left: 0;
    top: calc(50% - 20px);
    width: 50px;
    height: 40px;
    overflow: visible;
  }
  .vine,
  .vcoil {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .vine {
    animation: vdraw 0.9s cubic-bezier(0.4, 0.1, 0.3, 1) var(--d) forwards;
  }
  .vcoil {
    animation: vdraw 0.6s ease-out calc(var(--d) + 0.5s) forwards;
  }
  .vleaf {
    fill: var(--leaf);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 0 50%;
    animation: vleaf 0.5s ease-out calc(var(--d) + 0.9s) forwards;
  }
  .prow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding: 22px 0;
    animation: prise 0.8s cubic-bezier(0.3, 0.7, 0.3, 1) calc(var(--d) + 0.3s) both;
  }
  .thumb {
    flex: none;
    width: clamp(130px, 22vw, 180px);
    transform: rotate(var(--r));
    transition: transform 0.3s ease;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: auto;
    border: 6px solid var(--paper-lift);
    box-shadow: 4px 5px 0 rgba(19, 19, 19, 0.08);
  }
  .prow:hover .thumb {
    transform: rotate(0deg) translateY(-6px);
  }
  .made-text {
    flex: 1 1 240px;
    min-width: 0;
    max-width: 30em;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--ink);
    text-decoration: none;
  }
  .made-title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'SOFT' 48, 'WONK' 1;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.15;
  }
  .made-blurb {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--moss);
  }
  .made-cta {
    align-self: flex-start;
    margin-top: 4px;
    padding-bottom: 3px;
    border-bottom: 2px solid var(--ink);
    font-size: 14px;
    font-weight: 600;
  }
  .made-text:hover .made-cta {
    border-bottom-color: var(--spot);
  }
  @keyframes vdraw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes vleaf {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes prise {
    from {
      opacity: 0.15;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .terms {
    margin-top: clamp(56px, 8vw, 96px);
    padding: clamp(28px, 5vw, 48px);
  }
  .terms-kicker {
    margin-bottom: 6px;
    font-family: var(--font-hand);
    font-size: 17px;
    color: var(--sun);
  }
  .terms h2 {
    margin-bottom: var(--space-4);
    font-size: clamp(26px, 3.4vw, 36px);
  }
  .terms-body {
    max-width: 36em;
  }
  .terms-body p + p {
    margin-top: 14px;
  }

  .hello {
    margin-top: clamp(48px, 7vw, 80px);
  }
  .hello > p {
    margin-bottom: var(--space-2);
    font-size: 17px;
  }
  .hello-links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 32px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vine,
    .vcoil {
      animation: none;
      stroke-dashoffset: 0;
    }
    .vleaf {
      animation: none;
      opacity: 1;
    }
    .prow {
      animation: none;
    }
    .thumb {
      transition: none;
    }
  }
</style>
