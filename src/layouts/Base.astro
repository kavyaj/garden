---
// Every page: SiteHeader, the page's content, Footer. The paper grain sits behind it all.
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  /** Page title. Home passes nothing and gets the bare site name. */
  title?: string;
  description: string;
  /** Content width: the page (64rem), the Notes list (50rem), or the map (72rem). */
  width?: 'page' | 'list' | 'map';
  /** Load Tiro Devanagari Hindi in full (Quotes). */
  devanagari?: boolean;
  /** Load Tiro Devanagari Hindi subset to just these characters (Home's featured quote). */
  devanagariText?: string;
}
const { title, description, width = 'page', devanagari = false, devanagariText } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}, a garden I tend in public`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const fonts =
  'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1' +
  '&family=DM+Sans:opsz,wght@9..40,300..700&family=Shantell+Sans:wght@400..600' +
  (devanagari ? '&family=Tiro+Devanagari+Hindi' : '') +
  '&display=swap';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/kj-logo-512.png', site.url).href} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/kj-logo-small.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F4F1EA" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fonts} />
    <link rel="stylesheet" href={fonts} />
    {
      devanagariText && !devanagari && (
        <link
          rel="stylesheet"
          href={`https://fonts.googleapis.com/css2?family=Tiro+Devanagari+Hindi&display=swap&text=${encodeURIComponent(devanagariText)}`}
        />
      )
    }
  </head>
  <body class="kw-root">
    <div class="page">
      <svg class="grain" aria-hidden="true" focusable="false">
        <filter id="grain-fine">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" seed="7" stitchTiles="stitch"></feTurbulence>
          <feColorMatrix values="0 0 0 0 0.45  0 0 0 0 0.40  0 0 0 0 0.32  0 0 0 0.16 0"></feColorMatrix>
        </filter>
        <filter id="grain-fibre">
          <feTurbulence type="fractalNoise" baseFrequency="0.012 0.18" numOctaves="2" seed="3"></feTurbulence>
          <feColorMatrix values="0 0 0 0 0.45  0 0 0 0 0.40  0 0 0 0 0.32  0 0 0 0.09 0"></feColorMatrix>
        </filter>
        <rect width="100%" height="100%" filter="url(#grain-fine)"></rect>
        <rect width="100%" height="100%" filter="url(#grain-fibre)"></rect>
      </svg>

      <a class="skip" href="#main">Skip to the content</a>
      <SiteHeader />
      <main id="main" class:list={['wrap', { 'wrap--list': width === 'list', 'wrap--map': width === 'map' }]}>
        <slot />
      </main>
      <Footer />
    </div>

    <script is:inline>
      // Relative dates: <time datetime="2026-10-04" data-rel> reads "3 days ago". Without JS it's the plain date.
      (function () {
        var DAY = 864e5;
        var now = new Date();
        var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
        document.querySelectorAll('time[data-rel]').forEach(function (el) {
          var d = new Date(el.getAttribute('datetime') + 'T00:00:00Z');
          if (isNaN(d)) return;
          var days = Math.round((today - d.getTime()) / DAY);
          if (days > 30) return;
          el.textContent = days <= 0 ? 'today' : days === 1 ? 'yesterday' : days < 7 ? days + ' days ago' : days < 14 ? 'last week' : Math.floor(days / 7) + ' weeks ago';
        });
      })();

      // The page's tendril draws in once, when it scrolls into view.
      (function () {
        var vines = document.querySelectorAll('.kw-vine');
        if (!('IntersectionObserver' in window)) {
          vines.forEach(function (v) { v.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.6 });
        vines.forEach(function (v) { io.observe(v); });
      })();
    </script>
  </body>
</html>
